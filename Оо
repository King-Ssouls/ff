JOIN = """
    FROM applications a
    JOIN users u ON u.id = a.user_id
    JOIN transports t ON t.id = a.transport_id
    JOIN payments p ON p.id = a.payment_id
    JOIN statuses s ON s.id = a.status_id
    LEFT JOIN reviews r ON r.application_id = a.id
"""

SELECT = """
    SELECT
        a.id, a.start_date, a.created_at,
        u.full_name, u.phone, u.email,
        t.name AS transport, t.image,
        p.name AS payment,
        s.id AS status_id,
        s.name AS status,
        s.code AS status_code,
        r.text AS review
"""


@app.get("/profile")
@require_login()
def profile_page():
    items = db.all(
        SELECT + JOIN
        + " WHERE a.user_id = ? ORDER BY a.id DESC",
        (g.user["id"],),
    )

    return render_template(
        "profile.html",
        applications=items,
    )


@app.route("/application", methods=["GET", "POST"])
@require_login()
def application_page():
    if request.method == "POST":
        try:
            start = parse_date(
                request.form.get("start_date", "")
            )

            if start < date.today():
                raise ValueError(
                    "Выберите сегодняшнюю или будущую дату."
                )

            transport = db.one(
                "SELECT id FROM transports WHERE code = ?",
                (request.form.get("transport"),),
            )

            payment = db.one(
                "SELECT id FROM payments WHERE code = ?",
                (request.form.get("payment"),),
            )

            if not transport or not payment:
                raise ValueError(
                    "Выберите транспорт и способ оплаты."
                )

            status = db.one(
                "SELECT id FROM statuses WHERE code = 'new'"
            )

            db.run("""
                INSERT INTO applications
                (
                    user_id, transport_id, start_date,
                    payment_id, status_id
                )
                VALUES (?, ?, ?, ?, ?)
            """, (
                g.user["id"],
                transport["id"],
                start.isoformat(),
                payment["id"],
                status["id"],
            ))

        except ValueError as error:
            flash(str(error), "error")

        else:
            flash("Заявка создана.", "success")

            return redirect(
                url_for("profile_page")
            )

    return render_template(
        "application.html",
        transports=db.all(
            "SELECT * FROM transports ORDER BY id"
        ),
        payments=db.all(
            "SELECT * FROM payments ORDER BY id"
        ),
    )


@app.post("/applications/<int:application_id>/review")
@require_login()
def save_review(application_id):
    item = db.one(
        SELECT + JOIN
        + " WHERE a.id = ? AND a.user_id = ?",
        (application_id, g.user["id"]),
    )

    if not item:
        abort(404)

    review = request.form.get("review", "").strip()

    if item["status_code"] == "new":
        flash(
            "Отзыв доступен после изменения "
            "статуса администратором.",
            "error",
        )

    elif not review or len(review) > 1000:
        flash(
            "Отзыв должен содержать "
            "от 1 до 1000 символов.",
            "error",
        )

    else:
        db.run("""
            INSERT INTO reviews (application_id, text)
            VALUES (?, ?)
            ON CONFLICT(application_id)
            DO UPDATE SET text = excluded.text
        """, (application_id, review))

        flash("Отзыв сохранён.", "success")

    return redirect(url_for("profile_page"))


@app.get("/admin")
@require_login(admin=True)
def admin_page():
    conditions = []
    params = []

    if status := request.args.get("status", ""):
        conditions.append("s.code = ?")
        params.append(status)

    if query := request.args.get("q", "").strip():
        conditions.append(
            "(u.full_name LIKE ? OR t.name LIKE ?)"
        )
        params.extend([f"%{query}%"] * 2)

    where = (
        " WHERE " + " AND ".join(conditions)
        if conditions else ""
    )

    order = {
        "newest": "a.id DESC",
        "oldest": "a.id ASC",
        "start": "a.start_date ASC, a.id DESC",
        "name": "u.full_name ASC, a.id DESC",
    }.get(
        request.args.get("sort"),
        "a.id DESC",
    )

    total = db.one(
        "SELECT COUNT(*) AS n " + JOIN + where,
        params,
    )["n"]

    pages = max(1, (total + 4) // 5)

    page = request.args.get(
        "page",
        1,
        type=int,
    ) or 1

    page = max(1, min(page, pages))

    items = db.all(
        SELECT + JOIN + where
        + f" ORDER BY {order} LIMIT 5 OFFSET ?",
        (*params, (page - 1) * 5),
    )

    return render_template(
        "admin.html",
        applications=items,
        page=page,
        pages=pages,
        total=total,
        statuses=db.all(
            "SELECT * FROM statuses ORDER BY id"
        ),
    )


@app.post(
    "/admin/applications/<int:application_id>/status"
)
@require_login(admin=True)
def update_status(application_id):
    status_id = request.form.get(
        "status_id",
        type=int,
    )

    if not db.one(
        "SELECT id FROM statuses WHERE id = ?",
        (status_id,),
    ):
        abort(400, "Некорректный статус.")

    if not db.one(
        "SELECT id FROM applications WHERE id = ?",
        (application_id,),
    ):
        abort(404)

    db.run(
        """
        UPDATE applications
        SET status_id = ?
        WHERE id = ?
        """,
        (status_id, application_id),
    )

    flash("Статус обновлён.", "success")

    return redirect(url_for(
        "admin_page",
        q=request.form.get("q", ""),
        status=request.form.get("filter_status", ""),
        sort=request.form.get("sort", "newest"),
        page=request.form.get("page", 1, type=int),
    ))


