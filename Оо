BASE = Path(__file__).resolve().parent

DATA = Path(
    os.environ.get("PASSENGERS_DATA_DIR", str(BASE / "data"))
)
DATA.mkdir(parents=True, exist_ok=True)

key_file = DATA / "secret.key"

if not key_file.exists():
    key_file.write_text(
        secrets.token_hex(32),
        encoding="utf-8",
    )

app = Flask(__name__)

app.config.update(
    SECRET_KEY=(
        os.environ.get("SECRET_KEY")
        or key_file.read_text().strip()
    ),
    SESSION_COOKIE_HTTPONLY=True,
    SESSION_COOKIE_SAMESITE="Lax",
    MAX_CONTENT_LENGTH=16384,
)

db = Database(DATA / "database.db")
db.initialize()


def current_user():
    return db.one(
        """
        SELECT id, full_name, login, role
        FROM users
        WHERE id = ?
        """,
        (session.get("user_id"),),
    )


@app.context_processor
def common_data():
    session.setdefault("csrf", secrets.token_hex(32))

    return {
        "current_user": current_user(),
        "csrf_token": session["csrf"],
        "today": date.today().isoformat(),
    }


@app.before_request
def protect_forms():
    if request.method == "POST":
        token = session.get("csrf", "")

        if not token or not secrets.compare_digest(
            token,
            request.form.get("csrf_token", ""),
        ):
            abort(
                400,
                "Обновите страницу и повторите отправку формы.",
            )


def require_login(admin=False):
    def decorate(view):
        @wraps(view)
        def wrapped(*args, **kwargs):
            g.user = current_user()

            if not g.user:
                return redirect(url_for("login_page"))

            if admin and g.user["role"] != "admin":
                abort(
                    403,
                    "Доступ только для администратора.",
                )

            return view(*args, **kwargs)

        return wrapped

    return decorate


def parse_date(value):
    try:
        return date.fromisoformat(value)
    except (ValueError, TypeError):
        raise ValueError("Укажите корректную дату.")


@app.template_filter("date_ru")
def date_ru(value):
    return date.fromisoformat(value).strftime("%d.%m.%Y")


@app.route("/register", methods=["GET", "POST"])
def register_page():
    if request.method == "POST":
        form = request.form

        name = form.get("full_name", "").strip()
        phone = form.get("phone", "").strip()
        email = form.get("email", "").strip()
        login = form.get("login", "").strip()
        password = form.get("password", "")

        try:
            birthday = parse_date(
                form.get("birth_date", "")
            )

            if not name or len(name) > 200:
                raise ValueError(
                    "Укажите ФИО длиной до 200 символов."
                )

            if not re.fullmatch(
                r"(?=.*[A-Za-z])(?=.*\d)[A-Za-z0-9]{6,50}",
                login,
            ):
                raise ValueError(
                    "Логин: 6–50 символов, "
                    "латинские буквы и цифры."
                )

            if not 8 <= len(password) <= 128:
                raise ValueError(
                    "Пароль должен содержать "
                    "от 8 до 128 символов."
                )

            if birthday > date.today():
                raise ValueError(
                    "Дата рождения не может быть в будущем."
                )

            if not re.fullmatch(
                r"[+()0-9\s-]+",
                phone,
            ) or not (
                7 <= len(re.sub(r"\D", "", phone)) <= 15
            ):
                raise ValueError(
                    "Укажите корректный телефон."
                )

            if len(email) > 254 or not re.fullmatch(
                r"[^@\s]+@[^@\s]+\.[^@\s]+",
                email,
            ):
                raise ValueError(
                    "Укажите корректную электронную почту."
                )

            db.run("""
                INSERT INTO users
                (
                    full_name, birth_date, phone,
                    email, login, password_hash
                )
                VALUES (?, ?, ?, ?, ?, ?)
            """, (
                name,
                birthday.isoformat(),
                phone,
                email,
                login,
                generate_password_hash(password),
            ))

        except ValueError as error:
            flash(str(error), "error")

        except sqlite3.IntegrityError:
            flash("Этот логин уже занят.", "error")

        else:
            flash(
                "Регистрация завершена. Войдите в аккаунт.",
                "success",
            )
            return redirect(url_for("login_page"))

    return render_template("register.html")


@app.route("/", methods=["GET", "POST"])
@app.route("/login", methods=["GET", "POST"])
def login_page():
    if request.method == "POST":
        user = db.one(
            "SELECT * FROM users WHERE login = ?",
            (request.form.get("login", "").strip(),),
        )

        password = request.form.get("password", "")

        if (
            user
            and len(password) <= 128
            and check_password_hash(
                user["password_hash"],
                password,
            )
        ):
            session.clear()
            session["user_id"] = user["id"]

            return redirect(url_for(
                "admin_page"
                if user["role"] == "admin"
                else "profile_page"
            ))

        flash(
            "Неверный логин или пароль.",
            "error",
        )

    return render_template("login.html")


